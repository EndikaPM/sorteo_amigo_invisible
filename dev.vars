# Copia este archivo como ".dev.vars" (sin ".example") para probar en tu PC con "npm run dev".
# ".dev.vars" no se sube a ningún sitio. En producción estos valores se guardan como secretos con "wrangler secret put".

# La contraseña de la web: una frase larga (mínimo 12 caracteres).
APP_PASSWORD=pon-aqui-una-frase-larga

# La clave de la API de Resend (empieza por re_).
RESEND_API_KEY=re_pon_aqui_tu_clave

# Solo para pruebas sin enviar emails de verdad: apunta a un servidor falso. Para enviar de verdad, déjalo comentado.
# RESEND_URL=http://127.0.0.1:8788/emails
